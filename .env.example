# Copy this file to .env and adjust values before running `docker compose up`.

# Required — username and password for the KasmVNC session itself (internal only,
# no longer reachable directly from outside the Docker network).
VNC_USERNAME=dockeruser
VNC_PASSWORD=change-me

# Required — credentials for the custom sign-in page served by auth-proxy. This is
# what actually gates access from the browser now.
AUTH_USERNAME=change-me
AUTH_PASSWORD=change-me

# Nothing to configure for sessions: auth-proxy signs its session cookies with a
# JWT key it generates fresh in memory every time the container starts (never
# stored, never written here) — restarting the stack invalidates old sessions.
# The cookie itself is a browser-session cookie, so closing the browser logs you
# out, but reloading the page or reconnecting the desktop while it stays open does not.

# Optional overrides (defaults shown match the original hardcoded values).
# CONTAINER_NAME=kasmvnc
# AUTH_PROXY_CONTAINER_NAME=auth-proxy
# KASM_PORT=8444
# DATA_DIR=./data

# workspace-agent: which user's workspace / which project is active in this container.
# See ./workspace-agent/fixture/ for the available sample projects (project1..4).
# WORKSPACE_USER=rajdeep
# ACTIVE_PROJECT=project2

# Bind address for published ports.
# 0.0.0.0 = reachable from any network interface (default; fine on a trusted LAN).
# 127.0.0.1 = only reachable via localhost/SSH tunnel — recommended on a public server.
# BIND_ADDRESS=0.0.0.0

# Access at https://<host>:8444 — served by auth-proxy's custom login page, gated by
# AUTH_USERNAME/AUTH_PASSWORD above. It's HTTPS with a self-signed cert, so the
# browser will show a click-through security warning the first time.
#
# ./data (or DATA_DIR above) is bind-mounted to the whole home directory inside the
# kasmvnc container — Desktop, Downloads, Firefox profile, etc. all appear there and
# persist across restarts.
